{
    "name":  "earn-point-nft-backend",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "build":  "tsc -p tsconfig.json",
                    "db:dev":  "node scripts/dev-db.mjs",
                    "db:migrate":  "npm run build \u0026\u0026 node --env-file=.env dist/db/migrate-cli.js",
                    "dev":  "npm run build \u0026\u0026 node --env-file=.env dist/db/migrate-cli.js \u0026\u0026 node --env-file=.env dist/main.js",
                    "start":  "node dist/main.js",
                    "test":  "npm run build \u0026\u0026 node --env-file=.env.test --test \"dist/test/*.test.js\""
                },
    "engines":  {
                    "node":  "\u003e=22"
                },
    "dependencies":  {
                         "@nestjs/common":  "12.3.2",
                         "@nestjs/core":  "12.3.2",
                         "@nestjs/platform-express":  "12.3.2",
                         "@nestjs/throttler":  "6.7.1",
                         "helmet":  "8.3.0",
                         "otplib":  "13.6.0",
                         "pg":  "8.23.1",
                         "qrcode":  "1.5.4",
                         "reflect-metadata":  "0.2.2",
                         "rxjs":  "7.8.2",
                         "zod":  "4.6.7"
                     },
    "devDependencies":  {
                            "@types/express":  "5.0.6",
                            "@types/node":  "26.6.6",
                            "@types/pg":  "8.23.1",
                            "@types/qrcode":  "1.5.6",
                            "embedded-postgres":  "18.6.0-beta.19",
                            "typescript":  "7.0.2"
                        },
    "type":  "module"
}