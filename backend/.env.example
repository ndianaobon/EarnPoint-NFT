# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://earnpoint:earnpoint-local-dev@localhost:5433/earnpoint

# The website address used in email links, and the origins allowed to call the API.
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Encrypts two-step verification secrets. Generate your own, and keep it safe:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Sign-in and account requests allowed per minute, per IP address.
AUTH_RATE_LIMIT=10
